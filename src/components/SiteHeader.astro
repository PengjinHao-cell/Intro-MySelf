---
import { getEntry } from 'astro:content'
import MobileNav from './MobileNav'
import { primaryLinks } from './nav-links'

const site = await getEntry('settings', 'site')
const displayName = site?.data.displayName ?? 'Personal Digital Garden'
---

<header class="site-header">
  <div class="site-header__inner editorial-grid">
    <a class="site-header__brand" href="/">{displayName}</a>
    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {primaryLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <MobileNav client:load />
  </div>
</header>
