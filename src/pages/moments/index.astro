---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import MomentEntry from '../../components/MomentEntry.astro'
import { newestFirst, onlyPublished } from '../../domain/content'

const moments = newestFirst(onlyPublished(await getCollection('moments')))
---

<BaseLayout title="Moments — Personal Digital Garden" description="Chronological moments: photographs, learning progress, and everyday observations.">
  <div class="editorial-grid">
    <div class="listing">
      <h1 class="listing__title">Moments</h1>
      <p class="listing__lede">Photographs, learning progress, experiments, everyday observations.</p>
      <div class="listing__feed">
        {moments.map((entry) => <MomentEntry entry={entry} />)}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .listing {
    grid-column: 1 / -1;
    padding-block: var(--space-2xl) var(--space-4xl);
  }

  @media (min-width: 768px) {
    .listing {
      grid-column: 2 / 11;
    }
  }

  .listing__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
  }

  .listing__lede {
    margin-top: var(--space-md);
    font-family: var(--font-kai);
    color: var(--stone-text);
    line-height: var(--line-height-chinese);
  }

  .listing__feed {
    margin-top: var(--space-2xl);
  }
</style>
