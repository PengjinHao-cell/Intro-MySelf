---
import { getCollection, getEntry } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import NowStrip from '../components/NowStrip.astro'

const site = await getEntry('settings', 'site')
const displayName = site?.data.displayName ?? 'Personal Digital Garden'
const intro = site?.data.intro ?? ''

const timelineEntries = await getCollection('timeline')
const years = timelineEntries
  .map((entry) => ({ ...entry, items: [...entry.data.items].sort((a, b) => b.date.getTime() - a.date.getTime()) }))
  .sort((a, b) => b.data.year - a.data.year)
---

<BaseLayout title="About — Personal Digital Garden" description="Who is behind this garden, and how it came to be.">
  <div class="editorial-grid">
    <div class="about">
      <h1 class="about__title">About</h1>

      <section class="about__story" aria-labelledby="about-story-heading">
        <h2 id="about-story-heading" class="about__heading">The story</h2>
        <p class="about__name">{displayName}</p>
        <p class="about__intro">{intro}</p>
        <p class="about__note">
          This garden records the path from photography to computer vision: cameras first, then the
          question of how machines see.
        </p>
      </section>

      <NowStrip />

      <section class="about__timeline" aria-labelledby="about-timeline-heading">
        <h2 id="about-timeline-heading" class="about__heading">Timeline</h2>
        {
          years.map((entry) => (
            <div class="about__year">
              <h3 class="about__year-heading">{entry.data.year}</h3>
              <ol class="about__items">
                {
                  entry.items.map((item) => (
                    <li class="about__item">
                      <time class="about__item-date" datetime={item.date.toISOString().slice(0, 10)}>
                        {item.date.toISOString().slice(0, 10)}
                      </time>
                      <div>
                        <p class="about__item-title">{item.title}</p>
                        <p class="about__item-summary">{item.summary}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </div>
          ))
        }
      </section>

      {
        site?.data.social && site.data.social.length > 0 && (
          <section class="about__contact" aria-labelledby="about-contact-heading">
            <h2 id="about-contact-heading" class="about__heading">Contact</h2>
            <ul class="about__links">
              {
                site.data.social.map((link) => (
                  <li>
                    <a href={link.url} rel="me">{link.label}</a>
                  </li>
                ))
              }
            </ul>
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    grid-column: 1 / -1;
    padding-block: var(--space-2xl) var(--space-4xl);
  }

  @media (min-width: 768px) {
    .about {
      grid-column: 2 / 11;
    }
  }

  .about__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
  }

  .about__heading {
    margin-block: var(--space-3xl) var(--space-lg);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--moss);
  }

  .about__name {
    font-family: var(--font-serif-sc);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .about__intro {
    margin-top: var(--space-lg);
    font-family: var(--font-kai);
    font-size: 1.125rem;
    line-height: var(--line-height-chinese);
  }

  .about__note {
    margin-top: var(--space-md);
    color: var(--stone-text);
  }

  .about__year-heading {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--moss);
  }

  .about__items {
    margin: var(--space-lg) 0 0;
    padding: 0;
    list-style: none;
  }

  .about__item {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    border-top: 1px solid var(--stone);
  }

  @media (min-width: 768px) {
    .about__item {
      grid-template-columns: 7rem 1fr;
    }
  }

  .about__item-date {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--stone-text);
  }

  .about__item-title {
    font-family: var(--font-serif-sc);
    font-weight: 600;
  }

  .about__item-summary {
    margin-top: var(--space-2xs);
    color: var(--stone-text);
    font-size: 0.9375rem;
  }

  .about__links {
    display: flex;
    gap: var(--space-xl);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__links a {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    text-decoration-color: var(--moss);
    text-underline-offset: 4px;
  }
</style>
