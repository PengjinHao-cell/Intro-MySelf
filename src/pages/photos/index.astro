---
import { getCollection } from 'astro:content'
import BaseLayout from '../../layouts/BaseLayout.astro'
import PhotoFigure from '../../components/PhotoFigure.astro'
import { onlyPublished } from '../../domain/content'

const photos = onlyPublished(await getCollection('photos')).sort(
  (a, b) => (a.data.order ?? 0) - (b.data.order ?? 0),
)
---

<BaseLayout title="Photos — Personal Digital Garden" description="Curated photography: landscape, city, people, and experiment.">
  <div class="editorial-grid">
    <div class="listing">
      <h1 class="listing__title">Photos</h1>
      <p class="listing__lede">Curated photographs and photo stories.</p>
      <div class="photos-sequence">
        {
          photos.map((entry, index) => {
            const image = entry.data.images[0]
            return (
              <a class:list={['photos-sequence__item', index % 2 === 1 && 'photos-sequence__item--offset']} href={`/photos/${entry.id}`}>
                {
                  image && (
                    <PhotoFigure
                      src={image.src}
                      alt={image.alt}
                      width={image.width}
                      height={image.height}
                      caption={`${entry.data.category}${entry.data.city ? ` · ${entry.data.city}` : ''}`}
                    />
                  )
                }
                <span class="photos-sequence__title">{entry.data.title}</span>
              </a>
            )
          })
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .listing {
    grid-column: 1 / -1;
    padding-block: var(--space-2xl) var(--space-4xl);
  }

  .listing__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 500;
  }

  .listing__lede {
    margin-top: var(--space-md);
    font-family: var(--font-kai);
    color: var(--stone-text);
    line-height: var(--line-height-chinese);
  }

  .photos-sequence {
    margin-top: var(--space-2xl);
  }

  .photos-sequence__item {
    display: block;
    margin-bottom: var(--space-3xl);
    text-decoration: none;
  }

  .photos-sequence__title {
    display: block;
    margin-top: var(--space-md);
    font-family: var(--font-serif-sc);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .photos-sequence__item:hover .photos-sequence__title {
    text-decoration: underline;
    text-decoration-color: var(--moss);
    text-underline-offset: 4px;
  }

  @media (min-width: 768px) {
    .photos-sequence__item {
      max-width: 34rem;
    }

    .photos-sequence__item--offset {
      margin-left: auto;
      max-width: 30rem;
    }
  }
</style>
