---
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'

interface Props {
  title: string
  description: string
  image?: string
}

const { title, description, image } = Astro.props

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {
      canonical && <link rel="canonical" href={canonical.href} />
    }
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {
      canonical && <meta property="og:url" content={canonical.href} />
    }
    <meta name="robots" content="index, follow" />
    {
      image && (
        <>
          <meta property="og:image" content={image} />
          <meta name="twitter:card" content="summary_large_image" />
        </>
      )
    }
    <link rel="stylesheet" href="/fonts/noto-serif-sc/font.css" />
    <link rel="stylesheet" href="/fonts/lxgw-wenkai/font.css" />
    <link rel="stylesheet" href="/fonts/cormorant-garamond/font.css" />
    <link rel="stylesheet" href="/fonts/ibm-plex-mono/font.css" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
